import pygame
import math

pygame.init()

ekran = pygame.display.set_mode((900, 700))
pygame.display.set_caption("SENİ SEVİYORUM")

font = pygame.font.SysFont("arial", 22, bold=True)

noktalar = []

# Kalp noktalarını oluştur
for i in range(1000):

    t = i / 1000 * math.pi * 2

    x = 16 * math.sin(t) ** 3

    y = (
        13 * math.cos(t)
        - 5 * math.cos(2*t)
        - 2 * math.cos(3*t)
        - math.cos(4*t)
    )

    x *= 25
    y *= -25

    x += 450
    y += 350

    noktalar.append((x, y))


# Kaç yazı gösterileceği
gosterilen = 0

calisiyor = True

while calisiyor:

    for olay in pygame.event.get():

        if olay.type == pygame.QUIT:
            calisiyor = False

    ekran.fill((0, 0, 0))

    # Yavaş yavaş yazıları göster
    if gosterilen < len(noktalar):

        gosterilen += 2

    for i in range(0, gosterilen, 12):

        x, y = noktalar[i]

        yazi = font.render(
            "SENİ SEVİYORUM",
            True,
            (255, 50, 100)
        )

        rect = yazi.get_rect(
            center=(x, y)
        )

        ekran.blit(yazi, rect)

    pygame.display.flip()

    pygame.time.delay(15)

pygame.quit()